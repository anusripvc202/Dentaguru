{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "style.css",
      "use": "@vercel/static"
    },
    {
      "src": "app.js",
      "use": "@vercel/static"
    },
    {
      "src": "dentaguru_logo.png",
      "use": "@vercel/static"
    },
    {
      "src": "dentaguru_logo.svg",
      "use": "@vercel/static"
    },
    {
      "src": "dentaguru_tooth_icon.png",
      "use": "@vercel/static"
    },
    {
      "src": "dentaguru_tooth_icon_transparent.png",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/health",
      "dest": "/api/index.js"
    },
    {
      "src": "/style.css",
      "dest": "/style.css"
    },
    {
      "src": "/app.js",
      "dest": "/app.js"
    },
    {
      "src": "/dentaguru_logo.png",
      "dest": "/dentaguru_logo.png"
    },
    {
      "src": "/dentaguru_logo.svg",
      "dest": "/dentaguru_logo.svg"
    },
    {
      "src": "/dentaguru_tooth_icon.png",
      "dest": "/dentaguru_tooth_icon.png"
    },
    {
      "src": "/dentaguru_tooth_icon_transparent.png",
      "dest": "/dentaguru_tooth_icon_transparent.png"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
