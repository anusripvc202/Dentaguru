# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# MongoDB Database Configuration
MONGO_URI=mongodb://127.0.0.1:27017/dentaguru

# Supabase Cloud Configuration (Auth & Storage)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT & Authentication Secrets
JWT_SECRET=dentaguru_super_secret_jwt_key_2026
REFRESH_SECRET=dentaguru_super_secret_refresh_key_2026

# AWS S3 Cloud Storage (Optional Alternative)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=dentaguru-medical-files

# Firebase Admin Cloud Messaging (FCM Push Notifications)
FIREBASE_SERVICE_ACCOUNT=path/to/firebase-service-account.json
