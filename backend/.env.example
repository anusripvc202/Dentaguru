# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*
ALWAYS_ON_HOSTING=false

# Database Configuration (Supabase PostgreSQL)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
PRODUCTION_SUPABASE_URL=https://your-production-ref.supabase.co
TESTING_SUPABASE_URL=https://your-testing-ref.supabase.co

# JWT & Authentication Secrets (Set >=16-char strong random values in staging/production)
JWT_SECRET=replace-with-strong-random-jwt-secret
REFRESH_SECRET=replace-with-strong-random-refresh-secret
SUPABASE_JWT_SECRET=replace-with-supabase-project-jwt-secret

# On-Screen OTP Testing Mode (Staging / Local Testing ONLY - Hard-blocked when NODE_ENV=production)
# In staging (NODE_ENV=staging), any valid mobile number receives an on-screen OTP when authorized via x-staging-otp-key matching STAGING_OTP_ACCESS_KEY.
OTP_DELIVERY_MODE=on_screen
STAGING_OTP_ACCESS_KEY=replace-with-strong-random-staging-otp-access-key
ADMIN_PHONE=+91XXXXXXXXXX

# AWS S3 Cloud Storage (Optional Alternative)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=dentaguru-medical-files

# Firebase Admin Cloud Messaging (FCM Push Notifications)
FIREBASE_SERVICE_ACCOUNT=path/to/firebase-service-account.json

# SMS OTP Gateway (Fast2SMS Quick SMS for India +91)
FAST2SMS_API_KEY=your-fast2sms-authorization-api-key
FAST2SMS_ROUTE=q

# OTP Security (Uses Supabase PostgreSQL atomic RPC storage via SUPABASE_SERVICE_ROLE_KEY)
OTP_SALT=your-random-otp-hmac-salt-secret
